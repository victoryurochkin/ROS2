# ============================================================================
# Платформа: NVIDIA Jetson Orin Nano (Super), JetPack 7.2
# ----------------------------------------------------------------------------
# JetPack 7.2 == Jetson Linux (L4T) R39.2
#   ядро 6.8, rootfs Ubuntu 24.04 (noble), CUDA 13.2, cuDNN 9.20, TRT 10.16
#   Поддержка Jetson Orin Family появилась именно в JetPack 7.2
#   (в 7.0 / 7.1 поддерживался только Thor).
#
# ВАЖНОЕ АРХИТЕКТУРНОЕ РЕШЕНИЕ
# ----------------------------------------------------------------------------
# ТЗ требует ROS 2 Humble. Humble — это Ubuntu 22.04 (jammy); бинарных пакетов
# под noble не существует и не будет. На rootfs 24.04 есть три пути:
#
#   1) ROS 2 Jazzy из apt              -> выбран по умолчанию (ROS_DISTRO=jazzy)
#   2) Humble из исходников (~40-60 мин на кросс-сборке)  -> ROS_BUILD_MODE=source
#   3) Контейнер на jammy поверх ядра 6.8 -> работает (userspace развязан),
#      но CUDA 12.6 внутри несовместим с драйвером CUDA 13 на хосте.
#      Отвергнут: теряется GPU.
#
# Переключается одной переменной ниже. По умолчанию — Jazzy.
# Обоснование см. docs/01-architecture.md, раздел «ROS 2 на JetPack 7».
# ============================================================================

PLATFORM_ID="jetson-orin-nano-jp7"
DOCKER_PLATFORM="linux/arm64"
BASE_DOCKERFILE="docker/base/Dockerfile.jetson"
BASE_FROM="ubuntu:24.04"

# binary  -> ROS_DISTRO ставится из apt (jazzy)
# source  -> ROS_DISTRO собирается из исходников (humble на noble)
ROS_BUILD_MODE="binary"
ROS_DISTRO="jazzy"
ROS_BASE_PACKAGE="ros-jazzy-ros-base"

# --- параметры L4T --------------------------------------------------------
L4T_SUITE="r39.2"
L4T_SOC="t234"
L4T_RELEASE_MAJOR="39"
L4T_RELEASE_MINOR="2.0"
JETSON_CUDA_PACKAGES="cuda-toolkit-13-2 libcudnn9-dev-cuda-13 libnvinfer-dev libnvinfer-plugin-dev"
CUDA_VERSION="13.2"
CUDA_HOME="/usr/local/cuda-13.2"

# Orin Nano — тот же GA10B, sm_87.
# (Для сравнения: Thor T5000 — sm_110, потребовал бы отдельного файла платформы.)
CUDA_ARCHITECTURES="87"

PLATFORM_KIND="jetson"

NATIVE_RUNNER="ubuntu-24.04-arm"
SELF_HOSTED_RUNNER="self-hosted,jetson,orin-nano,jp7"

SUPPORTS_CROSS="true"

PLATFORM_DESCRIPTION="Jetson Orin Nano, JetPack 7.2 (L4T R39.2), CUDA 13.2, ROS 2 Jazzy, sm_87"
