# ============================================================================
# Платформа: NVIDIA Jetson AGX Orin 64GB, JetPack 6.2.2
# ----------------------------------------------------------------------------
# JetPack 6.2.2 == Jetson Linux (L4T) R36.5.0
#   ядро 5.15.185-tegra, rootfs Ubuntu 22.04, CUDA 12.6.68, cuDNN 9.3, TRT 10.3
#
# Готового образа nvcr.io/nvidia/l4t-jetpack:r36.5.0 в NGC НЕТ
# (последний опубликованный тег — r36.4.0). Поэтому базовый образ собираем
# из ubuntu:22.04 + официальный apt-репозиторий Jetson (r36.5).
# Это даёт точное соответствие версии на устройстве и воспроизводимость.
# ============================================================================

PLATFORM_ID="jetson-agx-orin-jp62"
DOCKER_PLATFORM="linux/arm64"
BASE_DOCKERFILE="docker/base/Dockerfile.jetson"
BASE_FROM="ubuntu:22.04"

ROS_DISTRO="humble"
ROS_BASE_PACKAGE="ros-humble-ros-base"

# --- параметры L4T --------------------------------------------------------
# Суффикс репозитория repo.download.nvidia.com/jetson/{common,SOC} <SUITE> main
L4T_SUITE="r36.5"
# SoC-репозиторий: t234 = Orin (AGX Orin / Orin NX / Orin Nano)
L4T_SOC="t234"
# Строка для /etc/nv_tegra_release — без неё postinst L4T-пакетов
# падает внутри контейнера, собираемого не на Jetson.
L4T_RELEASE_MAJOR="36"
L4T_RELEASE_MINOR="5.0"
# Метапакеты CUDA/cuDNN/TensorRT именно этого JetPack.
JETSON_CUDA_PACKAGES="cuda-toolkit-12-6 libcudnn9-dev-cuda-12 libnvinfer-dev libnvinfer-plugin-dev"
CUDA_VERSION="12.6"
CUDA_HOME="/usr/local/cuda-12.6"

# Orin (Ampere, GA10B) -> compute capability 8.7
CUDA_ARCHITECTURES="87"

PLATFORM_KIND="jetson"

# Нативная сборка: hosted arm64-раннер GitHub (Cobalt 100, 4 vCPU) либо
# self-hosted раннер на самом AGX Orin (label: self-hosted,jetson,agx-orin,jp62).
NATIVE_RUNNER="ubuntu-22.04-arm"
SELF_HOSTED_RUNNER="self-hosted,jetson,agx-orin,jp62"

SUPPORTS_CROSS="true"

PLATFORM_DESCRIPTION="Jetson AGX Orin 64GB, JetPack 6.2.2 (L4T R36.5.0), CUDA 12.6, ROS 2 Humble, sm_87"
