# ============================================================================
# Платформа: x86_64 (дискретные NVIDIA GPU)
# ----------------------------------------------------------------------------
# Файл описывает ВСЁ, что отличает одну целевую платформу от другой.
# Добавление новой платформы = добавление одного такого файла.
# Формат: обычный shell env-файл (source-ится скриптами и CI, парсер не нужен).
# ============================================================================

# Идентификатор платформы. Используется как суффикс тега образа.
PLATFORM_ID="x86_64-cuda"

# Docker-платформа для buildx.
DOCKER_PLATFORM="linux/amd64"

# Какой Dockerfile использовать для базового образа.
BASE_DOCKERFILE="docker/base/Dockerfile.x86_64"

# Родительский образ.
BASE_FROM="nvidia/cuda:12.6.3-devel-ubuntu22.04"

# Дистрибутив ROS 2. Humble = Ubuntu 22.04.
ROS_DISTRO="humble"

# Набор ROS-пакетов в базовом образе (ros-<distro>-<...>).
ROS_BASE_PACKAGE="ros-humble-ros-base"

# Версия CUDA внутри образа (справочно, для меток и тестов).
CUDA_VERSION="12.6"

# Целевые SM-архитектуры для nvcc (CMAKE_CUDA_ARCHITECTURES).
# 75=Turing, 80=A100, 86=Ampere consumer, 89=Ada, 90=Hopper.
CUDA_ARCHITECTURES="75;80;86;89;90"

# Тип платформы: generic | jetson. Влияет на runtime-проверки.
PLATFORM_KIND="generic"

# Раннер GitHub Actions для НАТИВНОЙ сборки.
NATIVE_RUNNER="ubuntu-24.04"

# Поддерживается ли кросс-сборка через QEMU (для amd64 на amd64-хосте не нужна).
SUPPORTS_CROSS="false"

# Человекочитаемое описание (идёт в OCI-метки образа).
PLATFORM_DESCRIPTION="x86_64 host with discrete NVIDIA GPU, CUDA 12.6, ROS 2 Humble"
