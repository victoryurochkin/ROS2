# syntax=docker/dockerfile:1.7
# ============================================================================
# Базовый образ: x86_64 + NVIDIA CUDA + ROS 2
# Собирается из официального nvidia/cuda:*-devel (в нём уже есть nvcc,
# заголовки и статические библиотеки CUDA).
# ============================================================================
ARG BASE_FROM=nvidia/cuda:12.6.3-devel-ubuntu22.04
FROM ${BASE_FROM}

ARG ROS_DISTRO=humble
ARG ROS_BASE_PACKAGE=ros-humble-ros-base
ARG CUDA_ARCHITECTURES="75;80;86;89;90"
ARG ROS_BUILD_MODE=binary
ARG PARALLEL_WORKERS=4
ARG PLATFORM_ID=x86_64-cuda
ARG PLATFORM_DESCRIPTION="x86_64 CUDA + ROS 2"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC

# --- 1. Системные зависимости ---------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg2 lsb-release locales tzdata \
        build-essential cmake ninja-build git wget unzip pkg-config \
        python3-pip python3-dev python3-setuptools \
        libeigen3-dev libgoogle-glog-dev libgflags-dev \
        libboost-all-dev libyaml-cpp-dev libtbb-dev \
        libpcl-dev libopencv-dev \
    && :

# --- 2. Репозиторий ROS 2 --------------------------------------------------
# Используется официальный пакет ros2-apt-source (актуальный способ с 2025 г.,
# после переезда на новый apt-хостинг). Ключ и sources.list ставятся вместе.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -euo pipefail; \
    . /etc/os-release; \
    ROS_APT_SOURCE_VERSION="$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest \
        | grep -F '"tag_name"' | head -n1 | awk -F'"' '{print $4}')"; \
    curl -fsSL -o /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.${VERSION_CODENAME}_all.deb"; \
    apt-get update && apt-get install -y /tmp/ros2-apt-source.deb && rm -f /tmp/ros2-apt-source.deb

# --- 3. ROS 2 + инструменты сборки ----------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ${ROS_BASE_PACKAGE} \
        ros-${ROS_DISTRO}-pcl-conversions \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-tf2-eigen \
        ros-${ROS_DISTRO}-cv-bridge \
        python3-colcon-common-extensions \
        python3-rosdep python3-vcstool \
    && rosdep init 2>/dev/null || true

RUN rosdep update --rosdistro "${ROS_DISTRO}" || true

# --- 4. Переменные окружения CUDA -----------------------------------------
ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
    ROS_DISTRO=${ROS_DISTRO} \
    PLATFORM_ID=${PLATFORM_ID} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- 5. Пакет-верификатор CUDA --------------------------------------------
# Собирается в КАЖДЫЙ базовый образ: доказывает, что nvcc в образе рабочий
# и что код действительно скомпилирован под нужные SM-архитектуры.
COPY tests/cuda_verify /opt/verify/src/cuda_verify
RUN set -euo pipefail; \
    source /opt/ros/${ROS_DISTRO}/setup.bash; \
    cd /opt/verify; \
    colcon build --merge-install \
        --parallel-workers "${PARALLEL_WORKERS}" \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
                     -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}"; \
    rm -rf build log

COPY docker/common/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

LABEL org.opencontainers.image.title="ros2-cuda-base:${PLATFORM_ID}" \
      org.opencontainers.image.description="${PLATFORM_DESCRIPTION}" \
      org.opencontainers.image.source="https://github.com/victoryurochkin/ROS2" \
      ru.armmeh.platform="${PLATFORM_ID}" \
      ru.armmeh.ros-distro="${ROS_DISTRO}" \
      ru.armmeh.cuda-architectures="${CUDA_ARCHITECTURES}"

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
