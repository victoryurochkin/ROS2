# Зависимости FAST-LIO2 (ветка ROS2).
#
# Используется форк Ericsii, а не Livox-SDK/livox_ros_driver2: в upstream
# сборка обычным colcon падает на CMake-ошибке
#   LIVOX_INTERFACES_INCLUDE_DIRECTORIES ... set to NOTFOUND
# Это известная незакрытая проблема (issues #131, #223), воспроизводится и
# вне нашей системы сборки, в том числе на Jazzy. Форк Ericsii собирается
# штатным colcon и используется большинством ROS 2-портов FAST-LIO.
repositories:
  livox_ros_driver2:
    type: git
    url: https://github.com/Ericsii/livox_ros_driver2.git
    # Ветка по умолчанию у этого форка называется именно так.
    version: feature/use-standard-unit
