# ============================================================================
# Манифест ROS 2-пакета: FAST-LIO2 (HKU MARS Lab)
# ----------------------------------------------------------------------------
# Проверено по репозиторию: ветка ROS2 в upstream существует, порт под ROS 2
# влит в феврале 2024. Штатная установка — с --recursive, в репозитории есть
# сабмодуль ikd-Tree.
#   https://github.com/hku-mars/FAST_LIO/tree/ROS2
#
# Добавление нового пакета в систему сборки = создание такого файла.
# Никакие Dockerfile и workflow при этом не меняются.
# ============================================================================

# Имя образа: ghcr.io/victoryurochkin/<PKG_NAME>:<теги>
PKG_NAME="fast_lio2"

# Имя ROS-пакета внутри репозитория. НЕ совпадает с PKG_NAME: в CMakeLists
# пакет называется fast_lio, по этому пути colcon кладёт исполняемые файлы
# (install/lib/fast_lio/...). Используется при верификации образа.
ROS_PACKAGE_NAME="fast_lio"

PKG_REPO_URL="https://github.com/hku-mars/FAST_LIO"

# Ветка с портом под ROS 2. В main лежит ROS 1-версия (catkin_make/roslaunch).
PKG_REF="ROS2"

PKG_SUBDIR=""

# ROS-дистрибутивы, на которых пакет проверен. Если платформа использует
# другой — build-package.sh предупредит, но сборку не заблокирует.
# Только Humble. На Jazzy пакет не собирается: hku-mars/FAST_LIO фиксирует
# C++14, а заголовки rclcpp в Jazzy требуют C++17 (std::is_convertible_v).
# Подтверждено нативным и кросс-прогонами на jetson-orin-nano-jp7,
# см. docs/04-troubleshooting.md.
SUPPORTED_ROS_DISTROS="humble"

# Зависимости, подтягиваемые через vcs import.
DEPS_REPOS_FILE="packages/fast_lio2.repos"

# Не-ROS зависимости + патч livox_ros_driver2 (см. комментарий в скрипте).
PREBUILD_SCRIPT="packages/prebuild/livox_ros2_stack.sh"

APT_DEPS="libpcl-dev libeigen3-dev libgoogle-glog-dev"

# livox_ros_driver2 использует один CMakeLists и для ROS 1, и для ROS 2;
# нужную ветку кода выбирают эти два define. Без них сборка идёт по ROS 1-пути
# и падает на отсутствующем roscpp.
# Форку Ericsii флаги выбора ROS-редакции не нужны: он собирается
# штатным colcon без build.sh и подмены package.xml.
PKG_CMAKE_ARGS=""

# Флаги CUDA: у upstream FAST-LIO2 GPU-ветки нет (ikd-Tree — CPU-алгоритм),
# поэтому здесь пусто. Для CUDA-форка достаточно дописать сюда, например,
# -DUSE_CUDA=ON: CMAKE_CUDA_ARCHITECTURES система подставляет сама, из
# описания платформы, и применяет ко всем пакетам оверлея.
# PKG_CMAKE_ARGS дополняет этот набор, а не заменяет его.

COLCON_ARGS=""

# Что проверять в собранном образе (ищется в install/lib/$ROS_PACKAGE_NAME/).
EXPECT_EXECUTABLES="fastlio_mapping"

# Проверка живости: ros2 launch fast_lio mapping.launch.py
