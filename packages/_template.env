# ============================================================================
# ШАБЛОН манифеста пакета. Скопировать, переименовать в <имя>.env, заполнить.
#   cp packages/_template.env packages/my_package.env
#   ./scripts/build-package.sh --package my_package --platform x86_64-cuda
# ============================================================================
PKG_NAME="my_package"            # обязательный: имя образа
ROS_PACKAGE_NAME=""              # имя ROS-пакета, если отличается от PKG_NAME
PKG_REPO_URL=""                  # обязательный
PKG_REF="main"                   # ветка/тег/коммит (у ROS 1-проектов часто
                                 # нужна отдельная ветка порта, проверьте!)
PKG_SUBDIR=""                    # подкаталог с ROS-пакетом, если нужен

SUPPORTED_ROS_DISTROS=""         # "humble jazzy" — на чём пакет проверен

DEPS_REPOS_FILE=""               # packages/my_package.repos
PREBUILD_SCRIPT=""               # packages/prebuild/my_deps.sh

APT_DEPS=""                      # системные пакеты через пробел
PKG_CMAKE_ARGS=""                # например -DUSE_CUDA=ON
COLCON_ARGS=""                   # например --packages-up-to my_package

EXPECT_EXECUTABLES=""            # что проверять в собранном образе
