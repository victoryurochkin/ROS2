# ============================================================================
# Манифест ROS 2-пакета: FAST-LIVO2
# ----------------------------------------------------------------------------
# ВАЖНО. Upstream hku-mars/FAST-LIVO2 — ЧИСТО ROS 1 проект:
# README требует Ubuntu 18.04-20.04, сборка через catkin_make, запуск через
# roslaunch. Ветки ROS 2 в нём нет (в репозитории только main). Собрать его
# в этой системе напрямую невозможно — colcon его не соберёт.
#
# Поэтому используется сообществом поддерживаемый порт под ROS 2 Humble:
#   https://github.com/Robotic-Developer-Road/FAST-LIVO2 (ветка humble)
# Он же тянет за собой ament-версию rpg_vikit (оригинальный rpg_vikit от
# xuankuzcr — catkin-проект и под ROS 2 не собирается).
#
# Если появится официальный ROS 2-порт от HKU MARS — достаточно поменять
# PKG_REPO_URL и PKG_REF в этом файле.
# ============================================================================

PKG_NAME="fast_livo2"
ROS_PACKAGE_NAME="fast_livo"

PKG_REPO_URL="https://github.com/Robotic-Developer-Road/FAST-LIVO2"
PKG_REF="humble"
PKG_SUBDIR=""

# Порт заявлен и проверен только на Humble. На Jazzy (платформа JetPack 7)
# сборка не гарантирована — build-package.sh предупредит об этом.
SUPPORTED_ROS_DISTROS="humble"

DEPS_REPOS_FILE="packages/fast_livo2.repos"

# Livox-SDK2 + патч livox_ros_driver2 + Sophus (нетемплейтная версия).
PREBUILD_SCRIPT="packages/prebuild/fast_livo2_deps.sh"

APT_DEPS="libpcl-dev libeigen3-dev libopencv-dev libgoogle-glog-dev libfmt-dev"

# Форку Ericsii флаги выбора ROS-редакции не нужны: он собирается
# штатным colcon без build.sh и подмены package.xml.
PKG_CMAKE_ARGS=""
COLCON_ARGS=""

EXPECT_EXECUTABLES="fastlivo_mapping"
